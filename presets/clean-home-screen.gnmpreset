  metadata:
    name: Clean Home Screen
    author: GoldenNugget Team
    description: 'A still, tidy Home Screen: no search button above the Dock, no icon parallax, no ticking second hand on the
      Clock icon and no shadows under the Dock and search field.'
    ios_min: '26.0'
    tags:
    - home screen
    - minimal
